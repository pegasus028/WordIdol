    fields: fields,
    actions: actions,
    errorCodes: errorCodes,
    countWords: countWords,
    isEmpty: isEmpty,
    enumHas: enumHas,
    checkField: checkField,
    validate: validate,
    trimAll: trimAll
  };
})();

